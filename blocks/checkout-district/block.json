{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "kiriminaja-official/checkout-district",
  "title": "KiriminAja Subdistrict",
  "description": "Searchable shipping destination subdistrict.",
  "category": "woocommerce",
  "parent": [
    "woocommerce/checkout-shipping-address-block"
  ],
  "textdomain": "kiriminaja-official",
  "supports": {
    "html": false,
    "multiple": false,
    "reusable": false,
    "inserter": false,
    "lock": false
  },
  "attributes": {
    "lock": {
      "type": "object",
      "default": {
        "remove": true,
        "move": true
      }
    }
  },
  "editorScript": "kiriof-checkout-district-editor",
  "script": "kiriof-buyer-checkout",
  "style": "kiriof-buyer-checkout"
}
